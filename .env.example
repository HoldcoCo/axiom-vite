# Public (exposed to the browser via Vite)
VITE_BOOKING_URL=https://cal.com/your-holdco-link

# ERPNext API credentials (server-side only — do NOT prefix with VITE_)
ERPNEXT_BASE_URL=https://your-erpnext.example.com
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# Optional: Lead "source" field (defaults to "Website")
ERPNEXT_LEAD_SOURCE=Auditors 15 Minutes

# Company name in ERPNext (required for Opportunities)
ERPNEXT_COMPANY=HOLDCO

# Optional: Opportunity Type in ERPNext (e.g. Sales)
ERPNEXT_OPPORTUNITY_TYPE=Sales

# SMTP credentials for the thank-you email (server-side only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@holdco.co
SMTP_FROM_NAME=Holdco
